# GuFaQuant-Pro 凭据环境变量模板
# 用法：
#   Docker Compose：复制为同目录 gufa-quant-pro.env 并填入真实值（保持文件名），
#     compose 示例通过 env_file 注入，避免把凭据写进 config.json。
#   systemd：复制为 /etc/gufa-quant-pro.env（chmod 600，属主 root:gufa），
#     与 deploy/gufa-quant-pro.service.example 的 EnvironmentFile 配合。
#
# 也可以在交互终端运行 setup 向导把这些值安全写入本地凭据库（二选一即可；
# 环境变量会覆盖本地凭据库，便于容器/服务化部署）。
#
# 安全提示：本文件含真实密钥，切勿提交到 git；建议文件权限 600。

# 交易所 API 凭据（config.example.json 默认键名）
GUFA_API_KEY=
GUFA_API_SECRET=
GUFA_API_PASSWORD=

# AI 断卦师凭据（ai.api_key_env 默认键名）
OPENAI_API_KEY=
